<Window x:Class="BlockchainConsensusModule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blockchain Consensus Module" Height="800" Width="1200" Background="#FF2D2D30">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <Border CornerRadius="5" Background="#FF3E3E42" Padding="10" Margin="5" Width="200" Height="50">
                <TextBlock Text="Node ID" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="NodeIdTextBox" Margin="80,0,0,0" Width="100" Background="#FF565656" Foreground="White" FontSize="12"/>
            </Border>
            <Border CornerRadius="5" Background="#FF3E3E42" Padding="10" Margin="5" Width="250" Height="50">
                <TextBlock Text="Consensus Type" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox x:Name="ConsensusTypeComboBox" Margin="130,0,0,0" Width="100" Background="#FF565656" Foreground="White" FontSize="12">
                    <ComboBoxItem Content="Proof of Work"/>
                    <ComboBoxItem Content="Proof of Stake"/>
                    <ComboBoxItem Content="Delegated Proof of Stake"/>
                    <ComboBoxItem Content="Byzantine Fault Tolerance"/>
                </ComboBox>
            </Border>
            <Button x:Name="StartConsensusButton" Content="Start" Width="100" Height="40" Margin="10,0,0,0" Background="#FF007ACC" Foreground="White" FontSize="14" Click="StartConsensus_Click"/>
            <Button x:Name="StopConsensusButton" Content="Stop" Width="100" Height="40" Margin="10,0,0,0" Background="#FFCC0000" Foreground="White" FontSize="14" Click="StopConsensus_Click"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="5" Background="#FF3E3E42" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Active Nodes" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <ListBox x:Name="ActiveNodesListBox" Background="#FF565656" Foreground="White" FontSize="12" Height="200" ItemsSource="{Binding ActiveNodes}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Ellipse Width="10" Height="10" Fill="Green" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="RefreshNodesButton" Content="Refresh" Width="100" Height="30" Margin="0,10,0,0" Background="#FF007ACC" Foreground="White" FontSize="12" Click="RefreshNodes_Click"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="5" Background="#FF3E3E42" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Consensus Status" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Current Leader:" Foreground="White" FontSize="14" Grid.Row="0"/>
                        <TextBlock x:Name="LeaderStatusTextBlock" Text="N/A" Foreground="LightYellow" FontSize="14" Grid.Row="0" Margin="120,0,0,0"/>
                        <TextBlock Text="Block Height:" Foreground="White" FontSize="14" Grid.Row="1" Margin="0,10,0,0"/>
                        <TextBlock x:Name="BlockHeightTextBlock" Text="0" Foreground="LightYellow" FontSize="14" Grid.Row="1" Margin="120,10,0,0"/>
                        <TextBlock Text="Participation %" Foreground="White" FontSize="14" Grid.Row="2" Margin="0,10,0,0"/>
                        <ProgressBar x:Name="ParticipationProgressBar" Minimum="0" Maximum="100" Value="0" Height="20" Grid.Row="2" Margin="120,10,0,0"/>
                        <TextBlock Text="Sync Status:" Foreground="White" FontSize="14" Grid.Row="3" Margin="0,10,0,0"/>
                        <TextBlock x:Name="SyncStatusTextBlock" Text="Disconnected" Foreground="LightCoral" FontSize="14" Grid.Row="3" Margin="120,10,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" CornerRadius="5" Background="#FF3E3E42" Margin="5" Padding="10">
            <StackPanel>
                <TextBlock Text="Blockchain Log" Foreground="White" FontSize="16" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
                    <ItemsControl x:Name="BlockchainLogItemsControl" ItemsSource="{Binding BlockchainLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="White" FontSize="12" Margin="2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="ClearLogButton" Content="Clear Log" Width="100" Height="30" Background="#FF007ACC" Foreground="White" FontSize="12" Click="ClearLog_Click"/>
                    <Button x:Name="ExportLogButton" Content="Export Log" Width="100" Height="30" Margin="10,0,0,0" Background="#FF007ACC" Foreground="White" FontSize="12" Click="ExportLog_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>