    output wire io_ready,
    output wire [31:0] extra_status,
    input wire [63:0] guest_context,
    output wire [63:0] host_context,
    input wire enable_debug_mode,
    output wire debug_event,
    input wire [63:0] debug_register_data,
    output wire [63:0] debug_status,
    input wire [63:0] vendor_specific_config,
    output wire [63:0] vendor_specific_status,
    input wire [63:0] custom_command,
    output wire [63:0] custom_response,
